# Copy to a private .env; never commit real secrets. Use hex passwords in URL DSNs.
SILICONFLOW_API_KEY=replace-with-your-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
POSTGRES_PASSWORD=replace-with-random-hex-admin-password
DATA_ANALYSIS_READER_PASSWORD=replace-with-different-random-hex-password
DATA_ANALYSIS_WRITER_PASSWORD=replace-with-different-random-hex-password
DATA_ANALYSIS_HTTP_PORT=32013

# Native wheel installation: set these in addition to the above.
# DATA_ANALYSIS_ADMIN_DSN=postgresql://app_admin:YOUR_ADMIN_PASSWORD@127.0.0.1:5433/data_analysis_agent
# DATA_ANALYSIS_POSTGRES_HOST=127.0.0.1
# DATA_ANALYSIS_POSTGRES_PORT=5433
# DATA_ANALYSIS_STATE_DIR=/absolute/private/copilot-state
# PGPASSFILE=/absolute/private/copilot-state/pgpass
# DATA_ANALYSIS_CATALOG_PATH=/absolute/private/copilot-state/synthetic-catalog.yaml
# DATA_ANALYSIS_DATASET_VERSION=synthetic-olist-v1
# DATA_ANALYSIS_DEMO_PORT=32013
# DATA_ANALYSIS_BOOTSTRAP_USERNAME=analyst
# DATA_ANALYSIS_TOKENIZER_PATH=/optional/local/tokenizer
